# Environment variables for Continuum Backend
# Copy this file to .env and set real values — never commit .env to source control.

# ── Database ────────────────────────────────────────────────────────────────
# Default: SQLite file in the backend/ directory
DATABASE_URL=sqlite:///./continuum.db

# ── JWT Security ─────────────────────────────────────────────────────────────
# REQUIRED: replace with a strong random secret (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_random_64_char_string

# REQUIRED: separate secret for CSRF tokens
CSRF_SECRET=change_this_to_another_random_64_char_string

# JWT algorithm — do not change unless you switch to RS256
ALGORITHM=HS256

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: http://localhost:5173,https://app.continuum.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Cookie settings ──────────────────────────────────────────────────────────
COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# lax is appropriate for same-site SPA; use strict if frontend and API share exact origin
COOKIE_SAMESITE=lax
